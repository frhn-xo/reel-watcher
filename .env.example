# Reel Watcher — environment template.
# Copy to `.env.local` and edit only if your setup differs from the defaults.
# Every value here is optional; with none set, the defaults below apply.

# Where your signed-in, remote-debugging Chromium is listening (host:port).
# This is the browser the app drives over the Chrome DevTools Protocol to reach
# Instagram as you. Start it with, e.g.:
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#     --remote-debugging-port=9222 --user-data-dir="$HOME/.reel-watcher-browser"
# Default: 127.0.0.1:9222
CDP_ENDPOINT=127.0.0.1:9222
